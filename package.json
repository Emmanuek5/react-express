{
  "name": "advanced-express",
  "version": "2.0.0",
  "description": "Interactive, server-rendered Express apps: state bindings, components, client-side routing, data fetching, forms and hot reload — no build step, no eval, CSP-friendly.",
  "type": "module",
  "main": "./dist/server/index.js",
  "types": "./dist/server/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    },
    "./client": "./dist/client/rx.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json",
    "test": "npm run build && npm run typecheck && npm run test:server && npm run test:e2e",
    "test:server": "node --test \"test/server/*.test.ts\"",
    "test:e2e": "playwright test",
    "example": "npm run build && node example/server.ts",
    "prepublishOnly": "npm test",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "docs:deploy": "npm run docs:build && wrangler pages deploy docs/.vitepress/dist"
  },
  "peerDependencies": {
    "express": "^4.17.0 || ^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/ejs": "^3.1.5",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "ejs": "^7.0.2",
    "esbuild": "^0.28.2",
    "express": "^4.21.2",
    "typescript": "^5.3.2",
    "vitepress": "^1.6.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Emmanuek5/react-express.git"
  },
  "keywords": [
    "express",
    "ejs",
    "ssr",
    "progressive-enhancement",
    "htmx-alternative",
    "reactive"
  ],
  "author": "blueobsidian",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Emmanuek5/react-express/issues"
  },
  "homepage": "https://github.com/Emmanuek5/react-express#readme"
}
